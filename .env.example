# ── copy this to ".env" and fill it in. NEVER commit the real .env ──

# The access code you print on your CV (the ONE password, for the medical gateway).
# Make it something clean to type, e.g. a short memorable phrase.
GATE_PASSWORD=put-your-cv-access-code-here

# Random secret that signs the access cookie so it can't be forged.
# Generate one with:   openssl rand -hex 16
COOKIE_SECRET=replace-with-openssl-rand-hex-16

# Port the glue server listens on (cloudflared points here). 8080 is fine.
PORT=8080

# Your domain (used by build.mjs to derive project URLs).
DOMAIN=heraberg.com
